# Kopiera till server/.env och byt ut hemligheterna. Committa aldrig .env.

PORT=3001
HOST=127.0.0.1
SQLITE_PATH=data/bokflode.sqlite

# Obligatoriskt. Minst 16 tecken. Slumpa ett eget värde.
SESSION_SECRET=byt-ut-till-en-lang-slumpad-strang

# Inloggning (en användare). BOKFLODE_USER är valfritt, default bokflode.
BOKFLODE_USER=bokflode
BOKFLODE_PASSWORD=byt-ut-detta-losenord

# Extra CORS-origin om frontend inte körs på 127.0.0.1:5173 / localhost:5173.
# FRONTEND_ORIGIN=http://127.0.0.1:4173

# Sätt true bakom HTTPS. Lämna osatt för lokal HTTP.
# COOKIE_SECURE=true
